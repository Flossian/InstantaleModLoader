{
  "entry": "item_image_variety.py",
  "api": 1,
  "kind": "fix",
  "name": {
    "en": "Item image expansion",
    "ja": "アイテム画像の拡充"
  },
  "description": {
    "en": "Spreads item icons across similar candidates instead of always the single best match, and adds weapon, armor, clothing, consumable and material images the stock assets lack. Per-category use and per-genre weights can be set for all worlds or per world, and event items are asked for English appearance text",
    "ja": "アイテム画像を「最も似た1枚」固定でなく似た候補から散らして選び、素材に無い武器・防具・服・消耗品・素材の絵を足す。足した絵は同じ種類の元画像をまとめた分類で、使い方とジャンルの重みを一括とワールド個別で決められる。イベントで得る品の外見文を英語で頼む。"
  },
  "version": "10",
  "author": "R01/Flossian",
  "state": ["item_image", "item_image_cross", "item_image_genres", "item_image_variety"],
  "settings": {
    "TOP_K": {
      "type": "int",
      "default": 10,
      "min": 1,
      "max": 50,
      "label": {
        "ja": "候補にする枚数の上限",
        "en": "Max candidate images"
      },
      "note": {
        "ja": "1 でいちばん似た1枚に固定（ジャンルの重みを置いた世界では、重みを足した後でいちばん似た1枚）",
        "en": "1 = always the single best match (in a world with genre weights, the best match after the weights are added)"
      },
      "group": {
        "ja": "選び方",
        "en": "How images are picked"
      }
    },
    "SIM_FLOOR": {
      "type": "float",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0,
      "label": {
        "ja": "候補にする類似度の下限（top1比）",
        "en": "Similarity floor (relative to top1)"
      },
      "note": {
        "ja": "上げるほど見た目に忠実、下げるほど散る",
        "en": "Higher = closer look, lower = more variety"
      },
      "group": {
        "ja": "選び方",
        "en": "How images are picked"
      }
    },
    "USE_EXTRA_DICT": {
      "type": "bool",
      "default": true,
      "label": {
        "ja": "同梱の追加辞書を使う",
        "en": "Use bundled extra dictionaries"
      },
      "note": {
        "ja": "素のゲームが一度も選ばない305枚（書類・魔物の素材・茸など）も候補にする",
        "en": "Also offer 305 stock images the game never picks (documents, creature parts, mushrooms)"
      },
      "group": {
        "ja": "選び方",
        "en": "How images are picked"
      }
    },
    "CROSS_SLOT": {
      "type": "bool",
      "default": true,
      "label": {
        "ja": "部位をまたいで探す",
        "en": "Search other item kinds"
      },
      "note": {
        "ja": "ゲームが付けた種類に合う絵が無い品（道具として来た包帯など）は、同じ大きさのほかの種類の絵も探す。装備品はまたがない",
        "en": "When no image of the item's kind fits (bandages sent as a tool, etc.), also search other 32x32 kinds. Equipment is never crossed"
      },
      "group": {
        "ja": "選び方",
        "en": "How images are picked"
      }
    },
    "GENRE_MEDIEVAL": {
      "type": "float",
      "default": 0.0,
